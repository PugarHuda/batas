# Nothing here is required to *read* the live deployment.
#
# agent/deployment.mjs carries the public identifiers — router, tokens, owner, ENS registry, HCS
# topic, ERC-8004 agent id — as defaults, so a fresh clone can run `npm run walkthrough` and check
# the whole position without being handed anything. That is the point of the project: a stranger
# verifies a mandate without permission from us.
#
# The values below are needed only to *act*: to ship a mandate, grant or revoke a name, publish to
# Hedera, or settle an x402 payment.

SEPOLIA_RPC_URL=https://rpc.sepolia.ethpandaops.io
SEPOLIA_PRIVATE_KEY=

# Hedera testnet, ECDSA accounts from https://portal.hedera.com
# AGENT pays for inspections; SERVICE receives them and publishes mandates to HCS.
HEDERA_AGENT_ID=
HEDERA_AGENT_KEY=
HEDERA_SERVICE_ID=
HEDERA_SERVICE_KEY=

ETHERSCAN_API_KEY=

# How long a granted mandate lasts, in hours. Default 2. script/Demo.s.sol and the agent read the
# same variable, so the two never disagree about the term.
BATAS_MANDATE_HOURS=

# Override any of the deployment defaults to point at your own instead. Leaving them blank uses
# the live one; see agent/deployment.mjs for the values.
BATAS_ROUTER=
BATAS_APP=
BATAS_TOKEN_A=
BATAS_TOKEN_B=
BATAS_OWNER=
BATAS_ENS_REGISTRY=
BATAS_MANDATE_NAME=
BATAS_HCS_TOPIC=
BATAS_AGENT_ID=

# The second agent's own wallet, for `node agent/counterparty.mjs --trade`.
#
# Its own, and that is the point rather than an inconvenience: a counterparty signing with the
# maker's key is the maker, and a demonstration of two agents sharing one wallet demonstrates one.
# Without this the counterparty reaches a verdict and says it is advising only.
#
# It also needs a little Sepolia ETH and some of tokenA — a counterparty arrives with its own side
# of the trade; `TokenMock.mint` is owner-only and will refuse it.
BATAS_COUNTERPARTY_KEY=

# Everything below has a default and is read only by the service, the clients, or the watch loop.
# Documented so a fresh clone is not left grepping for the variable that changes a number.

# Where the clients look for the service. `agent/inspect.mjs` defaults to the local server;
# `agent/counterparty.mjs` and the walkthrough default to the deployment.
BATAS_SERVICE_URL=                # http://localhost:4021 (inspect) · https://batas-one.vercel.app (counterparty)
# What the service says its own origin is, in the discovery manifest and the 402 it returns.
BATAS_PUBLIC_ORIGIN=              # https://batas-one.vercel.app
# Free-route brake, requests per minute per caller, answered as a 429. The paid route is not limited.
BATAS_FREE_RATE_LIMIT=            # 60
# `--watch`: renew when the live mandate has this many seconds left.
BATAS_RENEW_BEFORE_SECONDS=       # 3600
# The address the ENSv2 name is granted to, if not the signing key's own.
BATAS_AGENT_ADDRESS=              # the SEPOLIA_PRIVATE_KEY address
# ERC-8004 reputation registry on Sepolia. The one that circulates (0x8004B663056e9e57…) is wrong.
BATAS_REPUTATION_REGISTRY=        # 0x8004B663056A597Dffe9eCcC1965A193B7388713
# What one inspection costs, in tinybar, and the most a client will pay for one.
# The paid price is metered per request body; see priceFor() in agent/service.mjs.
X402_MAX_TINYBAR=                 # 1000000 (0.01 HBAR)
# Blocky402's Hedera testnet facilitator. Its /supported sits at the root, not under /v1.
X402_FACILITATOR_URL=             # https://api.testnet.blocky402.com
# The public mirror node the publication lookups read. Not ours, on purpose.
HEDERA_MIRROR_URL=                # https://testnet.mirrornode.hedera.com/api/v1
# Local port for `npm run service`.
PORT=                             # 4021
