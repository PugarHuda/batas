SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_PRIVATE_KEY=

# Hedera testnet, ECDSA accounts from https://portal.hedera.com
HEDERA_AGENT_ID=
HEDERA_AGENT_KEY=
HEDERA_SERVICE_ID=
HEDERA_SERVICE_KEY=

# How long a granted mandate lasts, in hours. Default 2. The demo script and the agent read the
# same variable, so the two never disagree about the term.
BATAS_MANDATE_HOURS=

# Optional: point the demo and agent at your own deployment instead of the Sepolia one
BATAS_ROUTER=
BATAS_TOKEN_A=
BATAS_TOKEN_B=
ETHERSCAN_API_KEY=

# ENSv2 mandate registry, from `node agent/ens.mjs --deploy`
BATAS_ENS_REGISTRY=
BATAS_AGENT_ADDRESS=

# HCS topic the mandates are published to, from `node agent/hcs.mjs --create-topic`.
# The service needs only this to read publications; publishing needs the Hedera keys above.
BATAS_HCS_TOPIC=

# Optional: let `agent/inspect.mjs` ask the service to resolve the operator behind a position
BATAS_AGENT_ID=
BATAS_OWNER=
